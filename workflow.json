        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"status\": \"read\",\n  \"message_id\": \"{{ $('WhatsApp Trigger').first().json.messages[0].id }}\",\n  \"typing_indicator\": { \"type\": \"text\" }\n}",
